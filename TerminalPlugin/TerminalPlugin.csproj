<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="VPet-Simulator.Windows.Interface" Version="1.1.0.50" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VPetLLM">
      <HintPath>..\..\VPetLLM\3000_VPetLLM\plugin\VPetLLM.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 安全规则表随 DLL 一起分发。放数据文件而不是编进 IL，是因为 vssadmin /
       bcdedit / certutil 这类字面量成片出现在程序集里时，杀软会把这张黑名单
       当成勒索软件的载荷清单来打分。 -->
  <ItemGroup>
    <None Update="TerminalPlugin.rules.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 命令执行拆在独立进程里，跟着插件一起分发。
       目的是让 VPet 进程不再出现"隐藏窗口拉起 cmd.exe 并回收三条流"这条行为特征——
       所有 shell 相关的代码和字面量都只存在于这个 exe 中。 -->
  <PropertyGroup>
    <TerminalHostProject>$(MSBuildProjectDirectory)\..\TerminalHost\TerminalHost.csproj</TerminalHostProject>
    <TerminalHostPublishDir>$(MSBuildProjectDirectory)\..\TerminalHost\publish\</TerminalHostPublishDir>
    <TerminalHostExe>$(TerminalHostPublishDir)VPetLLM.TerminalHost.exe</TerminalHostExe>
  </PropertyGroup>

  <Target Name="PublishTerminalHost" AfterTargets="Build" BeforeTargets="CopyPlugin">
    <Message Text="Publishing TerminalHost..." Importance="high" />
    <Exec Command="dotnet publish &quot;$(TerminalHostProject)&quot; -c $(Configuration) -o &quot;$(TerminalHostPublishDir)&quot;" />
  </Target>

  <Target Name="CopyPlugin" AfterTargets="Build">
    <ItemGroup>
      <PluginFiles Include="$(OutDir)$(TargetName).dll" />
      <PluginFiles Include="$(ProjectDir)TerminalPlugin.rules.json" />
      <PluginFiles Include="$(TerminalHostExe)" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="plugin" />
  </Target>

  <Target Name="UpdateSHA" AfterTargets="CopyPlugin">
    <PropertyGroup>
      <HelperProject>$(MSBuildProjectDirectory)\..\UpdateSHA_Helper\UpdateSHA_Helper.csproj</HelperProject>
      <HelperExe>$(MSBuildProjectDirectory)\..\UpdateSHA_Helper\bin\$(Configuration)\net8.0\UpdateSHA_Helper.exe</HelperExe>
      <PluginListPath>$(MSBuildProjectDirectory)\..\PluginList.json</PluginListPath>
      <TargetDllPath>$(ProjectDir)plugin\$(TargetName).dll</TargetDllPath>
      <BuildHelperCommand>dotnet build "$(HelperProject)" -c $(Configuration)</BuildHelperCommand>
      <RulesFilePath>$(ProjectDir)plugin\TerminalPlugin.rules.json</RulesFilePath>
      <HostExePath>$(ProjectDir)plugin\VPetLLM.TerminalHost.exe</HostExePath>
      <ExecHelperCommand>"$(HelperExe)" "$(ProjectName)" "$(TargetDllPath)" "$(PluginListPath)" "$(RulesFilePath)" "$(HostExePath)"</ExecHelperCommand>
    </PropertyGroup>
    <Message Text="Building SHA Helper..." Importance="high" />
    <Exec Command="$(BuildHelperCommand)" />
    <Message Text="Executing SHA Helper: $(ExecHelperCommand)" Importance="high" />
    <Exec Command="$(ExecHelperCommand)" />
  </Target>

</Project>
