<UserControl x:Class="StickerPlugin.winStickerSetting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#F5F5F5">
    <UserControl.Resources>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#C8C6C4"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#C8C6C4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="#F3F2F1"/>
            <Setter Property="Foreground" Value="#323130"/>
            <Setter Property="BorderBrush" Value="#E1DFDD"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EDEBE9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E1DFDD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#FAF9F8"/>
                                <Setter Property="Foreground" Value="#A19F9D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">

            <!-- 前置 MOD 状态 -->
            <TextBlock Text="前置 MOD" Foreground="#323130" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

            <Border x:Name="brdStatus" CornerRadius="4" BorderThickness="1"
                    BorderBrush="#E1DFDD" Background="#FFFFFF" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="txtStatusTitle" Text="正在检测…"
                               FontSize="13" FontWeight="Bold" Foreground="#323130" TextWrapping="Wrap"/>
                    <TextBlock x:Name="txtStatusDetail" Text=""
                               FontSize="12" Foreground="#605E5C" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button x:Name="btnOpenModSettings" Content="打开「LLM表情包」设置"
                        Click="btnOpenModSettings_Click" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"/>
                <Button x:Name="btnCopyWorkshop" Content="复制创意工坊链接"
                        Click="btnCopyWorkshop_Click" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0"/>
                <Button x:Name="btnRefresh" Content="重新检测"
                        Click="btnRefresh_Click" Style="{StaticResource BtnSecondary}"/>
            </StackPanel>

            <TextBlock Text="服务地址、API Key、显示时长、标签数量等全部配置都在「LLM表情包」MOD 的设置窗口里，本插件不再重复一份。"
                       FontSize="11" Foreground="#605E5C" TextWrapping="Wrap" Margin="0,0,0,20"/>

            <!-- 当前生效参数（读自 MOD） -->
            <TextBlock Text="当前生效参数" Foreground="#323130" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock x:Name="txtModParams" Text="—" FontSize="12" Foreground="#605E5C"
                       TextWrapping="Wrap" Margin="0,0,0,20"/>

            <!-- 测试 -->
            <TextBlock Text="测试" Foreground="#323130" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtTestTags" Grid.Column="0" Height="32" VerticalContentAlignment="Center"
                         Background="#FFFFFF" Foreground="#323130" BorderThickness="1"
                         BorderBrush="#E1DFDD" Padding="8,0" Text="可爱, 开心"/>
                <Button x:Name="btnTestSticker" Grid.Column="1" Content="测试发送" Width="90" Margin="8,0,0,0"
                        Click="btnTestSticker_Click" Style="{StaticResource BtnPrimary}"/>
                <Button x:Name="btnTestConnection" Grid.Column="2" Content="测试连接" Width="90" Margin="8,0,0,0"
                        Click="btnTestConnection_Click" Style="{StaticResource BtnSecondary}"/>
            </Grid>
            <TextBlock x:Name="txtTestResult" Text="" FontSize="11" Foreground="#605E5C"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>

            <Button x:Name="btnClose" Content="关闭" Width="100" HorizontalAlignment="Right"
                    Margin="0,25,0,0" Click="btnClose_Click" Style="{StaticResource BtnSecondary}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
